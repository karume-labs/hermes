# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (covers Bun workspaces: root, apps/*, packages/*)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# bun
bun.lockb
*.bun-build/

# testing + coverage
/coverage
coverage/

# next.js (apps/web)
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# expo / react-native (apps/mobile)
.expo/
**/.expo/
.expo-shared/
**/.expo-shared/
*.jks
*.keystore
android/build/
ios/build/
ios/Pods/

# drizzle + local data (never commit local DBs, models, device pulls)
drizzle/
data/
models/
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# production + misc
/build
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-error.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
apps/api/.env
apps/web/.env
apps/mobile/.env

# vercel + expo secrets
.vercel
.expo/.expo.*

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

uniwind-types.d.ts
