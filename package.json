{
  "name": "hermes-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:mobile": "bun run --cwd apps/mobile dev",
    "build": "bun run --cwd apps/web build",
    "build:api": "bun run --cwd apps/api build",
    "start": "bun run --cwd apps/web start",
    "start:api": "bun run --cwd apps/api start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd apps/api typecheck && bun run --cwd apps/mobile typecheck && bun run --cwd packages/db typecheck && bun run --cwd packages/validators typecheck && bun run --cwd packages/types typecheck && bun run --cwd apps/www typecheck",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "typecheck:api": "bun run --cwd apps/api typecheck",
    "typecheck:mobile": "bun run --cwd apps/mobile typecheck",
    "test": "bun run --cwd apps/api test",
    "test:api": "bun run --cwd apps/api test",
    "seed:demo": "bun run scripts/seed-demo.ts",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:seed": "bun run --cwd packages/db db:seed",
    "db:seed:fresh": "bun run db:migrate && bun run db:seed --force",
    "db:push": "bun run --cwd packages/db db:push",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:studio": "bun run --cwd packages/db db:studio",
    "update-ip": "bun run scripts/update-ip.ts",
    "dev:www": "bun run --cwd apps/www dev",
    "build:www": "bun run --cwd apps/www build",
    "android": "bun run --cwd apps/mobile android",
    "ios": "bun run --cwd apps/mobile ios",
    "web": "bun run --cwd apps/mobile web",
    "doctor": "bun run --cwd apps/mobile doctor",
    "prebuild": "bun run --cwd apps/mobile prebuild",
    "update-packages": "bun run --cwd apps/mobile update-packages",
    "db:seed:admin": "bun run --cwd packages/db db:seed:admin",
    "db:generate-auth": "bun run --cwd apps/api db:generate-auth",
    "typecheck:www": "bun run --cwd apps/www typecheck",
    "www": "bun run --cwd apps/www dev",
    "preview:www": "bun run --cwd apps/www preview",
    "format:check": "biome format .",
    "clean": "rm -rf .expo node_modules apps/*/node_modules apps/*/.expo apps/*/.astro apps/*/dist apps/*/.next"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^20",
    "lefthook": "^2.1.14",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
