{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@db/*": ["./src/*"],
      "@hermes/types": ["../types/src/index.ts"]
    }
  },
  "include": ["src/**/*", "drizzle.config.ts"]
}
