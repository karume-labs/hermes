{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@db/*": ["../db/src/*"],
      "@hermes/types": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
