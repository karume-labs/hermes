---
import "@/styles/global.css";

import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import SeoHead from "@/components/SeoHead.astro";
import type { Faq } from "@/lib/faqs";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/lib/seo";

interface Props {
  title?: string;
  description?: string;
  faq?: Faq[];
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  faq = [],
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} faq={faq} />
    <script is:inline>
      // Apply the saved theme before first paint so the page never flashes.
      (() => {
        const saved = localStorage.getItem("hermes-theme");
        const dark =
          saved === "dark" ||
          (saved === null &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    <noscript>
      <style>
        [data-animate],
        [data-stagger] > * {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll-in reveals; CSS owns the transition, this only flips the class
      // the first time a block enters the viewport.
      const root = document.documentElement;
      const toggle = document.querySelector("[data-theme-toggle]");
      const paintToggle = () => {
        const dark = root.dataset.theme === "dark";
        toggle?.querySelector("[data-icon-moon]")?.classList.toggle("hidden", dark);
        toggle?.querySelector("[data-icon-sun]")?.classList.toggle("hidden", !dark);
      };
      paintToggle();
      toggle?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("hermes-theme", next);
        paintToggle();
      });

      const blocks = Array.from(
        document.querySelectorAll("[data-animate], [data-stagger]"),
      );
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      let revealed = 0;

      const reveal = (element: Element) => {
        element.classList.add("is-visible");
        revealed += 1;
      };

      if (reduced || !("IntersectionObserver" in window)) {
        blocks.forEach(reveal);
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                reveal(entry.target);
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px" },
        );
        blocks.forEach((element) => observer.observe(element));

        // Safety net: a browser can keep the page hidden (background tab, an
        // embedded view that never paints) and stop delivering observer
        // callbacks. Rather than leave visible copy at opacity 0, reveal
        // anything already inside the viewport after a short grace period.
        window.setTimeout(() => {
          for (const element of blocks) {
            if (element.classList.contains("is-visible")) continue;
            const rect = element.getBoundingClientRect();
            if (rect.top < window.innerHeight && rect.bottom > 0) {
              reveal(element);
            }
          }
        }, 2500);
      }
    </script>
  </body>
</html>
