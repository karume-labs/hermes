---
import { DASHBOARD_URL } from "@/lib/constants";
---

<section class="border-t border-canvas-line bg-navy py-20 text-ink-inverse">
  <div
    class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-6 sm:flex-row sm:items-center sm:justify-between"
    data-animate
  >
    <div class="max-w-xl">
      <h2 class="font-display text-3xl font-extrabold">
        See it close a case for yourself.
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-inverse-muted">
        Sign in to a seeded clinic, work the queue from result to sign-off, and
        read the same result in the patient app.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a
        href={DASHBOARD_URL}
        class="group inline-flex items-center gap-2 rounded-md bg-spark px-6 py-3 text-sm font-bold text-ink transition-colors hover:bg-spark-strong"
      >
        Open the dashboard
        <svg
          class="size-4 transition-transform group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      <a
        href="#how-it-works"
        class="rounded-md border border-ink-inverse/40 bg-transparent px-6 py-3 text-sm font-bold text-ink-inverse transition-colors hover:border-ink-inverse hover:bg-ink-inverse/10"
      >
        Walk through the steps
      </a>
    </div>
  </div>
</section>
