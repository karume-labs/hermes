---
import StoreBadges from "@/components/StoreBadges.astro";
import { DASHBOARD_URL } from "@/lib/constants";
---

<section class="border-t border-canvas-line bg-brand-surface py-20 text-on-brand">
  <div
    class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-6 sm:flex-row sm:items-center sm:justify-between"
    data-animate
  >
    <div class="max-w-xl">
      <h2 class="font-display text-3xl font-extrabold">
        Get the result. Understand it. Close the loop.
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-on-brand-muted">
        Patients: download the app and sign in with the number your clinic has.
        Clinics: sign in to a seeded workspace, work a case from result to
        sign-off, and read the same result in the patient app.
      </p>
      <StoreBadges size="compact" class="mt-6" />
    </div>
    <div class="flex flex-col items-start gap-3">
      <a
        href={DASHBOARD_URL}
        class="group inline-flex items-center gap-2 rounded-md bg-accent px-6 py-3 text-sm font-bold text-on-accent transition-colors hover:bg-accent-strong"
      >
        Open the clinic dashboard
        <svg
          class="size-4 transition-transform group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      <a
        href="#how-it-works"
        class="rounded-md border border-on-brand/40 bg-transparent px-6 py-3 text-sm font-bold text-on-brand transition-colors hover:border-on-brand hover:bg-on-brand/10"
      >
        Walk through the steps
      </a>
    </div>
  </div>
</section>
