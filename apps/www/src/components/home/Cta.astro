---
import { DASHBOARD_URL } from "@/lib/constants";
---

<section class="border-t border-canvas-line bg-navy py-20 text-ink-inverse">
  <div
    class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-6 sm:flex-row sm:items-center sm:justify-between"
    data-animate
  >
    <div class="max-w-xl">
      <h2 class="font-display text-3xl font-extrabold">
        Put the follow-up on the record.
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-canvas-line">
        Open the dashboard with a seeded clinic, work the queue, and close a case
        end to end. Patient results unlock in the mobile app.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a
        href={DASHBOARD_URL}
        class="rounded-md bg-spark px-6 py-3 text-sm font-bold text-ink transition-colors hover:bg-spark-soft"
      >
        Open the dashboard
      </a>
      <a
        href="#how-it-works"
        class="rounded-md border border-ink-inverse/40 px-6 py-3 text-sm font-bold text-ink-inverse transition-colors hover:border-ink-inverse"
      >
        Read the loop again
      </a>
    </div>
  </div>
</section>
