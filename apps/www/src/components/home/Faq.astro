---
import { FAQS } from "@/lib/faqs";
---

<section id="faq" class="mx-auto max-w-3xl scroll-mt-24 px-6 py-20">
  <div class="text-center" data-animate>
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-muted">
      FAQ
    </p>
    <h2 class="mt-3 font-display text-3xl font-extrabold text-ink sm:text-4xl">
      Questions the workflow answers
    </h2>
  </div>

  <div class="mt-10 divide-y divide-canvas-line border-y border-canvas-line">
    {
      FAQS.map((faq) => (
        <details class="group py-5" data-animate>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-left font-semibold text-ink">
            <span>{faq.question}</span>
            <span
              class="mt-0.5 shrink-0 text-lg leading-none text-ink-muted transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">
            {faq.answer}
          </p>
        </details>
      ))
    }
  </div>
</section>
