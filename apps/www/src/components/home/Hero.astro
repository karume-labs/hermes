---
import StoreBadges from "@/components/StoreBadges.astro";
import { DASHBOARD_URL, HERO_HEADLINE } from "@/lib/constants";
---

<section class="mx-auto max-w-6xl px-6 pt-14 pb-20 sm:pt-20">
  <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
    <div data-animate>
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-muted"
      >
        For patients and the clinics that look after them
      </p>

      <h1
        class="mt-5 max-w-xl font-display text-4xl leading-[1.08] font-extrabold text-ink sm:text-[52px]"
      >
        {HERO_HEADLINE}
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-muted">
        A lab result lands. Hermes works out how urgent it is, sends it to you in
        plain words, and keeps the case with a named person at your clinic until
        a clinician signs it off. You see what it means and what happens next;
        nobody has to ring round to find out.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="#patients"
          class="group inline-flex items-center gap-2 rounded-md bg-accent px-6 py-3.5 text-sm font-bold text-on-accent transition-colors hover:bg-accent-strong"
        >
          Get the patient app
          <svg
            class="size-4 transition-transform group-hover:translate-x-0.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <a
          href={DASHBOARD_URL}
          class="rounded-md border border-line-strong bg-canvas-raised px-6 py-3.5 text-sm font-bold text-ink transition-colors hover:border-ink hover:bg-surface-tint"
        >
          I work at a clinic
        </a>
      </div>

      <p class="mt-4 text-xs text-ink-muted">
        Free on Android and iOS. Clinics sign in with a seeded account — no card,
        no setup call.
      </p>

      <div class="mt-8">
        <StoreBadges size="compact" />
      </div>

      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-muted">
        <li>Results in plain language</li>
        <li aria-hidden="true">·</li>
        <li>One tap to say you've seen it</li>
        <li aria-hidden="true">·</li>
        <li>4h, 48h and 7 day follow-up windows</li>
      </ul>
    </div>

    <!-- Who this is for: a patient, a phone, and the one line that matters. -->
    <div
      class="relative overflow-hidden rounded-[18px] border border-canvas-line bg-canvas-raised"
      data-animate
    >
      <svg
        viewBox="0 0 420 260"
        role="img"
        aria-label="A patient reading a lab result on their phone"
        class="block h-auto w-full"
      >
        <rect width="420" height="260" fill="var(--hermes-surface-tint)"></rect>
        <circle cx="312" cy="74" r="86" fill="var(--ill-bubble-info)" opacity="0.7"></circle>
        <circle cx="86" cy="196" r="58" fill="var(--ill-bubble-accent)" opacity="0.55"></circle>

        <!-- Person: shoulders, neck, head, arm to the phone -->
        <path
          d="M96 260c0-52 34-88 86-88s86 36 86 88z"
          fill="var(--ill-shirt)"></path>
        <path d="M158 150h48v40c0 12-48 12-48 0z" fill="var(--ill-shirt-shade)"></path>
        <circle cx="182" cy="118" r="44" fill="var(--ill-skin)"></circle>
        <path
          d="M138 112c0-28 20-48 44-48s44 20 44 48c0-16-14-22-44-22s-44 6-44 22z"
          fill="var(--ill-hair)"></path>
        <path
          d="M244 196c18-6 30-16 34-30"
          stroke="var(--ill-shirt-shade)"
          stroke-width="16"
          stroke-linecap="round"
          fill="none"></path>

        <!-- Phone -->
        <g transform="rotate(-6 300 168)">
          <rect
            x="252"
            y="104"
            width="104"
            height="176"
            rx="16"
            fill="var(--ill-device)"></rect>
          <rect x="259" y="111" width="90" height="162" rx="12" fill="var(--ill-screen)"
          ></rect>
          <rect x="270" y="126" width="52" height="7" rx="3.5" fill="var(--ill-shirt)"
          ></rect>
          <rect x="270" y="144" width="70" height="34" rx="6" fill="var(--color-actionable-fill)"
          ></rect>
          <rect x="278" y="154" width="46" height="6" rx="3" fill="var(--color-actionable)"
          ></rect>
          <rect x="278" y="165" width="30" height="5" rx="2.5" fill="var(--color-actionable)"
          ></rect>
          <rect x="270" y="190" width="70" height="6" rx="3" fill="var(--color-line)"
          ></rect>
          <rect x="270" y="202" width="58" height="6" rx="3" fill="var(--color-line)"
          ></rect>
          <rect x="270" y="216" width="48" height="6" rx="3" fill="var(--color-line)"
          ></rect>
          <rect
            x="270"
            y="238"
            width="70"
            height="20"
            rx="10"
            fill="var(--hermes-accent)"></rect>
          <rect x="288" y="246" width="34" height="5" rx="2.5" fill="var(--ill-device)"
          ></rect>
        </g>
      </svg>

      <div class="border-t border-canvas-line bg-canvas-raised p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span
            class="inline-flex items-center gap-1.5 rounded-full bg-actionable-fill px-2.5 py-1 text-[11px] font-bold tracking-[0.04em] text-actionable"
          >
            Needs a review today
          </span>
          <span class="text-xs font-semibold text-ink-muted">
            Sent 09:41 · read 09:44
          </span>
        </div>
        <p class="mt-3 text-base leading-snug font-semibold text-ink">
          “Your potassium is high. A clinician will call you before 2pm.”
        </p>
        <p class="mt-2 text-sm text-ink-muted">
          Amina Wanjiru, 42 · Riverbend Family Health
        </p>
      </div>
    </div>
  </div>
</section>
