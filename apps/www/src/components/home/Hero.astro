---
import { DASHBOARD_URL, SITE_TAGLINE } from "@/lib/constants";
---

<section class="mx-auto max-w-6xl px-6 pt-16 pb-20 sm:pt-24">
  <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr]">
    <div data-animate>
      <div class="flex items-center gap-3">
        <img src="/logo.svg" alt="" width="44" height="44" />
        <span
          class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-muted"
        >
          Care loop infrastructure
        </span>
      </div>

      <h1
        class="mt-8 max-w-xl font-display text-4xl leading-[1.1] font-extrabold text-ink sm:text-5xl"
      >
        {SITE_TAGLINE}
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-muted">
        Hermes takes the lab result the moment it lands, grades it by clinical
        severity, tells the patient in language they can act on, and keeps the
        case on a coordinator's queue until a clinician signs it off.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href={DASHBOARD_URL}
          class="rounded-md bg-spark px-6 py-3 text-sm font-bold text-ink transition-colors hover:bg-spark-soft"
        >
          Open the dashboard
        </a>
        <a
          href="#how-it-works"
          class="rounded-md border border-ink bg-canvas-raised px-6 py-3 text-sm font-bold text-ink transition-colors hover:bg-surface-tint"
        >
          See how the loop closes
        </a>
      </div>

      <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-muted">
        <li>FHIR Observations</li>
        <li aria-hidden="true">·</li>
        <li>HL7 ORU</li>
        <li aria-hidden="true">·</li>
        <li>4h / 24h / 72h SLAs</li>
        <li aria-hidden="true">·</li>
        <li>Push and SMS fallback</li>
      </ul>
    </div>

    <!-- Static case card: the product's core object, shown before any sign-in. -->
    <div
      class="rounded-xl border border-canvas-line bg-canvas-raised p-6 shadow-[0_1px_0_0_#e2e8f0]"
      data-animate
    >
      <div class="flex items-center justify-between">
        <span
          class="inline-flex items-center gap-1.5 rounded-full bg-urgent-fill px-2.5 py-1 text-[11px] font-bold tracking-[0.04em] text-urgent"
        >
          <svg
            viewBox="0 0 16 16"
            width="13"
            height="13"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M8 3.2 14 13.2 H2 Z M8 6.8 V9.6 M8 11.3 v.2" />
          </svg>
          Urgent
        </span>
        <span
          class="rounded-md bg-urgent-fill px-2 py-1 text-xs font-semibold text-urgent"
        >
          Due in 3h 12m
        </span>
      </div>

      <p class="mt-5 text-lg leading-snug font-semibold text-ink">
        Your potassium level needs a clinician review today.
      </p>
      <p class="mt-2 text-sm text-ink-muted">
        Received 09:41 · clinic-1 · specimen 8842-K
      </p>

      <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-canvas-line pt-5">
        <div>
          <dt class="text-[11px] font-semibold uppercase tracking-[0.1em] text-ink-muted">
            Mobile ack
          </dt>
          <dd class="mt-1 text-sm font-semibold text-ink">Pending</dd>
        </div>
        <div>
          <dt class="text-[11px] font-semibold uppercase tracking-[0.1em] text-ink-muted">
            Routing
          </dt>
          <dd class="mt-1 text-sm font-semibold text-ink">clinic-1</dd>
        </div>
        <div>
          <dt class="text-[11px] font-semibold uppercase tracking-[0.1em] text-ink-muted">
            Next step
          </dt>
          <dd class="mt-1 text-sm font-semibold text-ink">Escalate to duty clinician</dd>
        </div>
        <div>
          <dt class="text-[11px] font-semibold uppercase tracking-[0.1em] text-ink-muted">
            Channel
          </dt>
          <dd class="mt-1 text-sm font-semibold text-ink">Push, then SMS</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
