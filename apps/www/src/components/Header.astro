---
import { DASHBOARD_URL, NAV_ITEMS } from "@/lib/constants";
---

<!-- Sticky top navigation: flat paper canvas, one hairline rule. -->
<header
  class="sticky top-0 z-50 border-b border-canvas-line bg-canvas/90 backdrop-blur"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4"
    aria-label="Primary"
  >
    <a href="/" class="flex items-center gap-3" aria-label="Hermes home">
      <img src="/logo.svg" alt="" width="36" height="36" />
      <span class="font-display text-lg font-extrabold tracking-[0.16em]">
        Hermes
      </span>
    </a>

    <div class="flex items-center gap-6">
      <ul class="hidden items-center gap-7 md:flex">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-ink-muted transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        data-theme-toggle
        aria-label="Switch theme"
        class="grid size-9 place-items-center rounded-md border border-canvas-line text-ink-muted transition-colors hover:border-ink hover:text-ink"
      >
        <svg data-icon-moon class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg data-icon-sun class="size-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <a
        href={DASHBOARD_URL}
        class="hidden text-sm font-semibold text-ink-muted transition-colors hover:text-ink sm:block"
      >
        Clinic sign in
      </a>
      <a
        href="#patients"
        class="rounded-md bg-spark px-4 py-2 text-sm font-bold text-ink transition-colors hover:bg-spark-strong"
      >
        Get the app
      </a>
    </div>
  </nav>
</header>
