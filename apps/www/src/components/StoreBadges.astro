---
import { APP_LINKS } from "@/lib/constants";

interface Props {
  /** `compact` drops to a single row height for tight spots like the header. */
  size?: "regular" | "compact";
  class?: string;
}

const { size = "regular", class: className } = Astro.props;
const google = size === "compact" ? "h-9" : "h-12";
const apple = size === "compact" ? "h-[30px]" : "h-10";
---

<!--
  Official store badges, used unmodified as the platform guidelines require.
  Assets: Google Play badge from play.google.com/intl/en_us/badges and Apple's
  "Download on the App Store" badge from developer.apple.com. Both already
  carry their own border, so they sit on light and navy surfaces unchanged.
-->
<div class:list={["flex flex-wrap items-center gap-3", className]}>
  <a
    href={APP_LINKS.ios}
    class="inline-flex rounded-lg transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    rel="noopener"
  >
    <img
      src="/badges/app-store.svg"
      alt="Download on the App Store"
      width="120"
      height="40"
      class:list={["w-auto", apple]}
    />
  </a>

  <a
    href={APP_LINKS.android}
    class="inline-flex rounded-lg transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    rel="noopener"
  >
    <img
      src="/badges/google-play.png"
      alt="Get it on Google Play"
      width="646"
      height="250"
      class:list={["w-auto", google]}
    />
  </a>
</div>
