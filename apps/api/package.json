{
  "name": "@hermes/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate-auth": "bunx @better-auth/cli@latest generate --output ../../packages/db/src/auth/schema/index.ts --config ./src/features/auth/services/config.ts --yes",
    "format": "biome format --write",
    "lint": "biome check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@elysiajs/cors": "^1.1.1",
    "@hermes/types": "workspace:*",
    "@hermes/validators": "workspace:*",
    "@sinclair/typebox": "^0.34.40",
    "better-auth": "^1.7.17",
    "croner": "^10.0.0",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.44.2",
    "elysia": "^1.4.0",
    "elysia-helmet": "^3.1.0",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "bun-types": "latest",
    "typescript": "^5"
  }
}
