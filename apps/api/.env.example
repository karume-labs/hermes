# development | production | test. Production refuses to start on any
# documented development default and never returns login codes.
NODE_ENV=development
PORT=8001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hermes
# Shared service credential (`Authorization: Bearer …`); production requires 24+ characters.
API_SECRET=dev-secret-change-me
# Trust X-Forwarded-For only behind a proxy that rewrites it (compose sets this).
TRUST_PROXY=false
NEXT_PUBLIC_API_URL=http://localhost:8001
# Origin the API is mounted at; Better Auth builds its /auth baseURL from this.
API_URL=http://localhost:8001
# Dashboard origin allowed to send credentialed requests.
FRONTEND_URL=http://localhost:3000
# Signing secret for Better Auth sessions — generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=hermes-development-secret-change-me-now
# Optional outbound sink for queued notifications; empty = queue only.
NOTIFY_WEBHOOK_URL=
# Transactional SMS gateway receiving { to, text }. Required in production;
# when empty, login codes are returned as `devCode` in development only.
SMS_WEBHOOK_URL=
# HMAC secret labs sign webhook bodies with.
WEBHOOK_SECRET=dev-webhook-secret-change-me
# Patient session lifetime and SMS code lifetime.
PATIENT_SESSION_DAYS=30
PATIENT_CODE_TTL_MINUTES=10
UPLOAD_DIR=uploads
