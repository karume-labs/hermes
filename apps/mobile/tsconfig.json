{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["bun-types"],
    "paths": {
      "@/*": ["./*"],
      "@hermes/types": ["../../packages/types/src/index.ts"],
      "@hermes/validators": ["../../packages/validators/src/index.ts"],
      "@db/*": ["../../packages/db/src/*"],
      "@api/*": ["../api/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
