{
  "name": "@hermes/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run update-ip && expo start --dev-client -c",
    "android": "bun run update-ip && expo prebuild --clean && expo run:android",
    "ios": "bun run update-ip && expo start -c --ios",
    "web": "expo start -c --web",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo node_modules",
    "start": "bun run update-ip && expo start -c",
    "doctor": "expo-doctor --verbose",
    "update-packages": "expo install --check",
    "prebuild": "expo prebuild --clean",
    "update-ip": "bun ../../scripts/update-ip.ts"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@hermes/tokens": "workspace:*",
    "@hermes/types": "workspace:*",
    "@rn-primitives/accordion": "^1.5.2",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/aspect-ratio": "^1.5.2",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/collapsible": "^1.5.2",
    "@rn-primitives/context-menu": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/hover-card": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/menubar": "^1.5.2",
    "@rn-primitives/popover": "^1.5.2",
