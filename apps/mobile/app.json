{
  "expo": {
    "name": "Hermes Care",
    "slug": "hermes-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hermescare",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hermes.care",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your screening results with Face ID."
      }
    },
    "android": {
      "package": "com.hermes.care",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Hermes Care saves your confirmatory visit and its reminder to your calendar.",
          "remindersPermission": "Hermes Care adds a reminder for your confirmatory visit."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
