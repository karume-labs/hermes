{
  "expo": {
    "name": "Hermes Care",
    "slug": "hermes-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/core/icon.png",
    "scheme": "hermescare",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hermes.care",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your screening results with Face ID."
      }
    },
    "android": {
      "package": "com.hermes.care",
      "adaptiveIcon": {
        "foregroundImage": "./public/core/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Hermes Care saves your confirmatory visit and its reminder to your calendar.",
          "remindersPermission": "Hermes Care adds a reminder for your confirmatory visit."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./public/core/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "image": "./public/core/splash-icon.png",
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
